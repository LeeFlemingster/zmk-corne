#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&mt {
    flavor = "balanced";
};

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮  ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
     &kp NUBS    &kp SQT     &kp COMMA   &kp DOT     &kp P       &kp Y          &kp F       &kp G       &kp C       &kp R       &kp L       &kp FSLH
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
     &kp ESC     &kp A      &mt LMETA O &mt LALT E  &mt LCTRL U  &kp I          &kp D       &kp H       &kp T       &kp N       &kp S       &kp MINUS
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
     &kp LSHFT   &kp SEMI    &kp Q       &kp J       &kp K       &kp X          &kp B       &kp M       &kp W       &kp V       &kp Z       &kp RSHFT
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┴───────────┴───────────┴───────────╯
                                         &mo 1       &kp RET     &kp SPACE      &kp BSPC    &kp DEL     &mo 1
//                                     ╰───────────┴───────────┴───────────╯  ╰───────────┴───────────┴───────────╯
                        >;
                };
                L1 {
                        bindings = <
// ╭─────────┬─────────┬─────────┬─────────┬─────────┬─────────╮  ╭─────────┬─────────┬─────────┬─────────┬─────────┬─────────╮
    &kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &none
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤  ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
     &kp TAB   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &none
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤  ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
     &trans   &kp EQUAL &kp HASH  &kp LBKT  &kp RBKT   &none        &none    &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &trans
// ╰─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤  ├─────────┼─────────┼─────────┴─────────┴─────────┴─────────╯
                                   &trans    &trans    &trans       &trans    &trans    &trans
//                               ╰─────────┴─────────┴─────────╯  ╰─────────┴─────────┴─────────╯
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
        };
};
